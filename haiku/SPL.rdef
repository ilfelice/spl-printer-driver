resource app_signature "application/x-vnd.spl-compatible";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 3,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "SPL Compatible",
	long_info = "Printer driver for SPL2/QPDL laser printers. Based on SpliX. GPL v2."
};
